{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "declarationMap": false,
    "outDir": "./dist",
    // "rootDir": "./src",
    "composite": false,
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "moduleResolution": "nodenext",
  },
  "exclude": [
    "**/dist",
    "./node_modules"
  ]
}

{
  "name": "teamsketch-roomservice",
  "version": "1.0.0",
  "private": true,
  "description": "Horizontally scalable Yjs WebSocket server for TeamSketch, based on y/hub (y-redis)",
  "type": "module",
  "scripts": {
    "start:server": "node ./bin/server.js",
    "start:worker": "node ./bin/worker.js",
    "dev:server": "node --env-file .env ./bin/server.js",
    "dev:worker": "node --env-file .env ./bin/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "node tests/index.js"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "dotenv": "^17.2.2",
    "ioredis": "^5.8.0",
    "lib0": "^0.2.93",
    "mysql2": "^3.11.0",
    "redis": "^4.6.12",
    "uws": "github:uNetworking/uWebSockets.js#v20.56.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.5.6"
  },
  "optionalDependencies": {
    "minio": "^7.1.3",
    "postgres": "^3.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "ws": "^8.16.0",
    "y-websocket": "^2.0.4"
  }
}
